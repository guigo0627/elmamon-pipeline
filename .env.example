# Facebook API Configuration
# Copiar a .env y completar con tus credenciales

# ID de tu página de Facebook
# Obtener en: https://www.facebook.com/[tu-pagina]/about
FACEBOOK_PAGE_ID=tu_page_id_aqui

# Token de acceso de la página
# Obtener en: https://developers.facebook.com/tools/explorer/
# Permisos necesarios: pages_manage_posts, pages_read_engagement, publish_video
FACEBOOK_ACCESS_TOKEN=tu_access_token_aqui

# Opcional: Token de larga duración (60 días)
# Generar con: https://developers.facebook.com/tools/debug/accesstoken/
FACEBOOK_LONG_LIVED_TOKEN=
